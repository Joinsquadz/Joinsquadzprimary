{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --import ./dist/instrument.mjs --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:concurrency": "vitest run --config vitest.concurrency.config.ts",
    "backfill:upload-owners": "node backfill-upload-owners.mjs",
    "restore:drill": "node restore-drill.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@google-cloud/storage": "^7.19.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.56.0",
    "@supabase/supabase-js": "^2.107.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/cost-math": "workspace:*",
    "@workspace/db": "workspace:*",
    "pg": "^8.20.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "nodemailer": "^9.0.1",
    "openid-client": "^6.8.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "posthog-node": "^5.36.4",
    "stripe": "^22.2.0",
    "stripe-replit-sync": "^1.0.0",
    "twilio": "^6.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/pg": "^8.20.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^7.2.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.8"
  }
}
